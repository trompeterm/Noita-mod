{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noita-rl.dev/schemas/curriculum.schema.json",
  "title": "Noita RL Curriculum",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "stages"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenarios", "advance", "regress"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": { "type": "string" },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scenario", "weight"],
              "properties": {
                "scenario": { "type": "string" },
                "weight": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          },
          "advance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["window", "min_success_rate"],
            "properties": {
              "window": { "type": "integer", "minimum": 1 },
              "min_success_rate": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "regress": {
            "type": "object",
            "additionalProperties": false,
            "required": ["window", "max_success_rate"],
            "properties": {
              "window": { "type": "integer", "minimum": 1 },
              "max_success_rate": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
